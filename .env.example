NODE_ENV=production
SERVER_PORT=5000
PORT=5000

# MongoDB URI (Atlas or replica set)
MONGODB_URI=mongodb://localhost:27017/bito_db?replicaSet=rs0

# JWT Secrets
JWT_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Webhook Secret
WEBHOOK_SECRET=your-webhook-secret-change-in-production

# Logging
LOG_DIR=logs
LOG_LEVEL=info

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=/api/v1
