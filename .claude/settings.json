      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ps *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(ls *)",
      "Bash(cat *)",
